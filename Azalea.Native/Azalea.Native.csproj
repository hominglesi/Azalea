<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>$(AssemblyName)</Title>
    <Version>1.0.0</Version>
    <Authors>hominglesi</Authors>
    <Company>Azalea</Company>
    <Description>Bindings for native libraries used in Azalea projects.</Description>
    <PackageIcon>azalea-icon.png</PackageIcon>
    <PackageIconUrl>https://i.imgur.com/UPsEzXU.png</PackageIconUrl>
    <RepositoryUrl>https://github.com/hominglesi/Azalea</RepositoryUrl>
    <PackageReleaseNotes>https://github.com/hominglesi/Azalea/releases</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Azalea.SourceGeneration\Azalea.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Azalea.SourceGeneration\bin\$(Configuration)\netstandard2.0\Azalea.SourceGeneration.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"></None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Azalea\Resources\Textures\azalea-icon.png" Visible="false" Pack="true" PackagePath="\"  />
    <None Include="README.md" Visible="false" Pack="true" PackagePath="\"  />
  </ItemGroup>

</Project>
